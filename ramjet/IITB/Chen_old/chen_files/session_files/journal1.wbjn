# encoding: utf-8
# 2025 R1
SetScriptVersion(Version="25.1.122")
template1 = GetTemplate(TemplateName="Geometry")
system1 = template1.CreateSystem()
geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.Edit()
system2 = template1.CreateSystem(
    Position="Right",
    RelativeTo=system1)
geometryComponent1 = system2.GetComponent(Name="Geometry")
geometryComponent2 = system1.GetComponent(Name="Geometry")
geometryComponent1.ReplaceWithShare(
    TargetSystem=system2,
    ComponentToShare=geometryComponent2,
    SourceSystem=system1)
geometryComponent1.DeleteShare(System=system2)
system1.DisplayText = "2d"
system2.DisplayText = "3d"
Save(Overwrite=True)
geometry2 = system2.GetContainer(ComponentName="Geometry")
geometry2.Edit()
template2 = GetTemplate(TemplateName="Fluid Flow")
system3 = template2.CreateSystem(
    Position="Right",
    RelativeTo=system2)
system3.Delete()
system4 = template2.CreateSystem(
    Position="Below",
    RelativeTo=system2)
meshComponent1 = system4.GetComponent(Name="Mesh")
geometryComponent1.TransferData(TargetComponent=meshComponent1)
meshComponent1.Refresh()
mesh1 = system4.GetContainer(ComponentName="Mesh")
mesh1.Edit()
geometry1.Exit()
geometry2.Exit()
Save(Overwrite=True)
mesh1.Exit()
geometry1.Edit()
system5 = template1.CreateSystem(
    Position="Below",
    RelativeTo=system1)
system5.DisplayText = "exp"
geometry3 = system5.GetContainer(ComponentName="Geometry")
geometry3.Edit()
geometry3.Exit()
geometry1.Exit()
Save(Overwrite=True)
